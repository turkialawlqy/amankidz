<?xml version="1.0" encoding="utf-8"?>
<!-- مساعد الفيديوهات الكبيرة يشتغل على كمبيوتر بالبيت (http على الشبكة المحلية) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
